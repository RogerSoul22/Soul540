{
  "name": "soul540",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "prepare": "husky",
    "start": "pnpm --filter @soul540/api start",
    "dev": "pnpm dev:all",
    "build": "pnpm build:main && pnpm build:franchise && pnpm build:factory && pnpm build:api",
    "build:main": "pnpm --filter @soul540/portal-main build",
    "build:franchise": "pnpm --filter @soul540/portal-franchise build",
    "build:factory": "pnpm --filter @soul540/portal-factory build",
    "preview": "pnpm --filter @soul540/portal-main preview",
    "api": "pnpm --filter @soul540/api dev",
    "dev:all": "concurrently \"pnpm api\" \"pnpm dev:main\" \"pnpm dev:franchise\" \"pnpm dev:factory\"",
    "seed": "tsx apps/api/src/scripts/seed.ts",
    "seed:units": "tsx apps/api/src/scripts/seed-units.ts",
    "format:check": "prettier --check . --ignore-unknown",
    "format:write": "prettier --write . --ignore-unknown",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:theme": "node scripts/check-theme-overrides.mjs",
    "typecheck": "tsc --noEmit --project apps/api/tsconfig.json",
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:staged": "node scripts/check-architecture.mjs --staged",
    "quality:check": "pnpm format:check && pnpm architecture:check && pnpm check:encoding && pnpm typecheck",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "build:api": "pnpm --filter @soul540/api build",
    "dev:main": "pnpm --filter @soul540/portal-main dev",
    "dev:franchise": "pnpm --filter @soul540/portal-franchise dev",
    "dev:factory": "pnpm --filter @soul540/portal-factory dev",
    "migrate:remove-plaintext": "tsx apps/api/src/scripts/migrate-remove-plaintext.ts",
    "migrate:main-certificate": "tsx apps/api/src/scripts/migrate-main-certificate.ts",
    "reconcile:finances": "tsx apps/api/src/scripts/reconcile-finances.ts",
    "migrate:finances": "tsx apps/api/src/scripts/migrate-finances.ts",
    "revert:finances": "tsx apps/api/src/scripts/revert-finance-migration.ts",
    "migrate:franchise-tenants": "tsx apps/api/src/scripts/migrate-franchise-tenants.ts"
  },
  "dependencies": {
    "@soul540/contracts": "workspace:*",
    "@soul540/domain": "workspace:*",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "fast-xml-parser": "^5.8.0",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7",
    "serverless-http": "^4.0.0",
    "tsx": "^4.15.7",
    "xml-crypto": "^6.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "sass": "^1.77.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
