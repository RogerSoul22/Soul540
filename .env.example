MONGO_URI=mongodb://localhost:27017/soul540
PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Chave AES-256-GCM do cofre de certificados: 64 caracteres hexadecimais.
ENCRYPTION_KEY=

# Migração única opcional do certificado legado; remova após executar o comando.
# NFE_CERT_BASE64=
# NFE_CERT_PASSWORD=

# nfe.io — emissão eletrônica de NFS-e e NF-e
NFEIO_API_KEY=sua-chave-api-nfeio
NFEIO_COMPANY_ID=id-da-empresa-na-nfeio

# Chave do cofre de senhas (o usuário vê a própria senha em Minha conta). Sem ela, usa-se o JWT_SECRET.
PASSWORD_VAULT_KEY=
