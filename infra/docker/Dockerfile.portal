FROM node:22-alpine AS build
WORKDIR /app

ARG PORTAL
COPY . .

RUN corepack enable && corepack prepare pnpm@11.2.2 --activate && pnpm install --frozen-lockfile && \
    if [ "$PORTAL" = "main" ]; then \
      pnpm --filter @soul540/portal-main build && cp -R apps/main/dist /tmp/portal-dist && cp infra/docker/nginx-main.conf /tmp/nginx.conf; \
    elif [ "$PORTAL" = "factory" ]; then \
      pnpm --filter @soul540/portal-factory build && cp -R apps/factory/dist /tmp/portal-dist && cp infra/docker/nginx-portal.conf /tmp/nginx.conf; \
    else \
      pnpm --filter @soul540/portal-franchise build && cp -R apps/franchise/dist /tmp/portal-dist && cp infra/docker/nginx-portal.conf /tmp/nginx.conf; \
    fi

FROM nginx:alpine
COPY --from=build /tmp/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /tmp/portal-dist /usr/share/nginx/html
