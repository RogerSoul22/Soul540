FROM node:22-alpine
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate && pnpm install --frozen-lockfile

COPY apps/api/ ./apps/api/
COPY shared/ ./shared/
COPY packages/ ./packages/
COPY tsconfig.json ./

EXPOSE 3001
CMD ["node_modules/.bin/tsx", "apps/api/src/index.ts"]
